#:import get_color_from_hex kivy.utils.get_color_from_hex

# ============================================================
#  TEMA — paleta y componentes compartidos por todas las pantallas
# ============================================================
#:set C_BG           get_color_from_hex('#FFFFFF')
#:set C_SURFACE      get_color_from_hex('#F2F3F7')
#:set C_SURFACE_DOWN get_color_from_hex('#E5E7EE')
#:set C_INK          get_color_from_hex('#111318')
#:set C_MUTED        get_color_from_hex('#858B99')
#:set C_DISABLED     get_color_from_hex('#C7CBD4')
#:set C_LINE         get_color_from_hex('#E6E8EE')
#:set C_DANGER       get_color_from_hex('#D64550')
#:set FONT_ICONS     'assets/fonts/MaterialIcons-Regular.ttf'
#:set FONT_BOLD      'data/fonts/Roboto-Bold.ttf'


# ---------- Línea separadora ----------
<Divisor@Widget>:
    size_hint_y: None
    height: dp(1)
    canvas:
        Color:
            rgba: C_LINE
        Rectangle:
            pos: self.pos
            size: self.size


# ---------- Tarjeta flotante (menús y sugerencias): blanca, borde fino y sombra suave ----------
<Tarjeta@BoxLayout>:
    radio: dp(20)
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.07
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [self.radio or dp(20)]
        Color:
            rgba: C_BG
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radio or dp(20)]
        Color:
            rgba: C_LINE
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, self.radio or dp(20)
            width: dp(1)


# ---------- Botón circular con icono (la fuente de iconos trae todos los símbolos) ----------
<BotonIcono@ButtonBehavior+Label>:
    size_hint: None, None
    size: dp(46), dp(46)
    pos_hint: {'center_y': .5}
    font_name: FONT_ICONS
    font_size: sp(26)
    color: C_INK
    disabled_color: C_DISABLED
    canvas.before:
        Color:
            rgba: C_SURFACE_DOWN if self.state == 'down' else (0, 0, 0, 0)
        Ellipse:
            pos: self.pos
            size: self.size


# ---------- Botón flotante ----------
<BotonFlotante@ButtonBehavior+Label>:
    size_hint: None, None
    size: dp(62), dp(62)
    font_name: FONT_ICONS
    font_size: sp(32)
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.18
        Ellipse:
            pos: self.x - dp(1), self.y - dp(5)
            size: self.width + dp(2), self.height + dp(2)
        Color:
            rgba: (0.25, 0.26, 0.30, 1) if self.state == 'down' else C_INK
        Ellipse:
            pos: self.pos
            size: self.size


# ---------- TextInput sin fondo ----------
<CampoLimpio@TextInput>:
    background_normal: ''
    background_active: ''
    background_disabled_normal: ''
    background_color: 0, 0, 0, 0
    foreground_color: C_INK
    hint_text_color: C_DISABLED
    cursor_color: C_INK
    cursor_width: dp(2)
    selection_color: 0.07, 0.07, 0.09, 0.2
