<NotaItem>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(84)
    padding: dp(14), dp(8)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: (0.24, 0.24, 0.28, 1) if self.state == 'down' else (0.16, 0.16, 0.19, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

    Label:
        text: root.titulo
        bold: True
        font_size: sp(17)
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        shorten: True
        shorten_from: 'right'

    Label:
        text: root.preview
        font_size: sp(13)
        color: 0.75, 0.75, 0.78, 1
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        shorten: True
        shorten_from: 'right'

    Label:
        text: root.fecha
        font_size: sp(11)
        color: 0.45, 0.65, 0.95, 1
        halign: 'left'
        valign: 'middle'
        text_size: self.size


<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.09, 0.09, 0.11, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(12)

        BoxLayout:
            size_hint_y: None
            height: dp(50)

            Label:
                text: "NotePad"
                font_size: sp(26)
                bold: True
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Button:
                text: '+'
                size_hint_x: None
                width: dp(50)
                font_size: sp(28)
                background_normal: ''
                background_color: 0.1, 0.6, 0.9, 1
                on_press: root.crear_nueva_nota()

        TextInput:
            id: buscador
            hint_text: "Buscar notas..."
            multiline: False
            size_hint_y: None
            height: dp(46)
            padding: dp(12), dp(12)
            on_text: root.mostrar_notas(self.text)

        ScrollView:
            GridLayout:
                id: notas_container
                cols: 1
                size_hint_y: None
                spacing: dp(10)
                height: self.minimum_height